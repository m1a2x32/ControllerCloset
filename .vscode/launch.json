{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32G070",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "device": "STM32G070xx",
            "interface": "swd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/ClosetController.elf",
            "runToEntryPoint": "main",
            "svdFile": "${workspaceFolder}/boards/stm32g0x/stm32g070.svd",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32g0x.cfg"
            ],
            "preLaunchTask": "Build and Compile",
            "postLaunchCommands": [
                "monitor reset halt",
                "monitor flash write_image erase ${workspaceFolder}/build/Debug/ClosetController.elf"
            ],
        }
    ]
}